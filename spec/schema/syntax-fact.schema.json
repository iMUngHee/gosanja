{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "syntax-fact.schema.json",
  "type": "object",
  "properties": {
    "anchor": {"$ref": "syntax-fact.schema.json#/$defs/anchor"},
    "body": {"$ref": "file.schema.json#/$defs/range"},
    "visibility": {"type": "string"},
    "qualifiers": {"type": "array", "items": {"type": "string"}},
    "attributes": {"type": "array", "items": {"type": "string"}},
    "outline": {"type": "array", "items": {"$ref": "syntax.schema.json#/$defs/node"}}
  },
  "required": ["anchor"],
  "if": {"required": ["row"]},
  "then": {
    "properties": {
      "row": {"const": "test"},
      "test": {"enum": ["attribute", "cfg"]},
      "body": false,
      "visibility": false,
      "qualifiers": false,
      "attributes": false,
      "outline": false
    },
    "required": ["row", "anchor", "test"]
  },
  "else": {"properties": {"test": false}},
  "$defs": {
    "anchor": {
      "type": "object",
      "properties": {
        "file": {"$ref": "file.schema.json#/$defs/path"},
        "line": {"type": "integer", "minimum": 0},
        "col": {"type": "integer", "minimum": 0},
        "name": {"type": "string"}
      },
      "required": ["file", "line"],
      "anyOf": [{"required": ["col"]}, {"required": ["name"]}]
    }
  }
}
