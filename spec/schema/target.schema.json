{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "target.schema.json",
  "type": "object",
  "properties": {
    "scope": {
      "anyOf": [
        {
          "$ref": "file.schema.json#/$defs/path"
        },
        {
          "const": "."
        }
      ]
    },
    "key": {
      "$ref": "build.schema.json#/$defs/key"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "$ref": "build.schema.json#/$defs/root"
    },
    "entity": {
      "$ref": "entity.schema.json#/$defs/key"
    },
    "required_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test": {
      "const": true
    },
    "src": {
      "type": "string",
      "pattern": "^adapter:[a-z0-9-]+/build$"
    }
  },
  "required": [
    "scope",
    "key",
    "kind",
    "name",
    "src"
  ]
}
