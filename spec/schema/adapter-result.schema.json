{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter-result.schema.json",
  "type": "object",
  "properties": {
    "contract": {"$ref": "adapter-manifest.schema.json#/$defs/version"},
    "layers": {
      "type": "object",
      "properties": {
        "base": {
          "allOf": [{"$ref": "adapter-result.schema.json#/$defs/entry"}],
          "properties": {"merged": {"type": "array", "items": {"type": "string"}}}
        },
        "syntax": {"$ref": "adapter-result.schema.json#/$defs/entry"},
        "calls": {"$ref": "adapter-result.schema.json#/$defs/entry"}
      }
    },
    "builds": {"type": "array", "items": {"$ref": "adapter-result.schema.json#/$defs/build"}},
    "tools": {"type": "array", "items": {"$ref": "adapter-result.schema.json#/$defs/tool"}}
  },
  "required": ["contract", "layers"],
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "status": {"enum": ["ok", "failed"]},
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {"$ref": "adapter-result.schema.json#/$defs/code"},
              "message": {"type": "string"}
            },
            "required": ["code"]
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {"$ref": "file.schema.json#/$defs/path"},
              "code": {"$ref": "adapter-result.schema.json#/$defs/code"}
            },
            "required": ["file", "code"]
          }
        }
      },
      "required": ["status"]
    },
    "tool": {
      "type": "object",
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}},
      "required": ["name", "version"]
    },
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "build": {
      "type": "object",
      "properties": {
        "id": {"$ref": "adapter-result.schema.json#/$defs/portable", "minLength": 1},
        "toolchain": {"$ref": "adapter-result.schema.json#/$defs/not-absolute"},
        "target": {"$ref": "adapter-result.schema.json#/$defs/portable"},
        "profile": {"$ref": "adapter-result.schema.json#/$defs/portable"},
        "features": {"type": "array", "items": {"$ref": "adapter-result.schema.json#/$defs/not-absolute"}}
      },
      "required": ["id"]
    },
    "portable": {"type": "string", "pattern": "^[^/\\\\]*$"},
    "not-absolute": {"type": "string", "not": {"pattern": "^(/|\\\\|~|[A-Za-z]:[/\\\\])"}}
  }
}
