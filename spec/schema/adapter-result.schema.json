{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter-result.schema.json",
  "type": "object",
  "properties": {
    "contract": {"$ref": "adapter-manifest.schema.json#/$defs/version"},
    "layers": {
      "type": "object",
      "properties": {
        "base": {
          "type": "object",
          "properties": {
            "status": {"enum": ["ok", "failed"]},
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {"$ref": "adapter-result.schema.json#/$defs/code"},
                  "message": {"type": "string"}
                },
                "required": ["code"]
              }
            }
          },
          "required": ["status"]
        },
        "syntax": {
          "type": "object",
          "properties": {
            "status": {"enum": ["ok", "failed"]},
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {"$ref": "adapter-result.schema.json#/$defs/code"},
                  "message": {"type": "string"}
                },
                "required": ["code"]
              }
            }
          },
          "required": ["status"]
        },
        "calls": {
          "type": "object",
          "properties": {
            "status": {"enum": ["ok", "failed"]},
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {"$ref": "adapter-result.schema.json#/$defs/code"},
                  "message": {"type": "string"}
                },
                "required": ["code"]
              }
            }
          },
          "required": ["status"]
        }
      }
    },
    "builds": {"type": "array", "items": {"$ref": "adapter-result.schema.json#/$defs/build"}},
    "tools": {"type": "array", "items": {"$ref": "adapter-result.schema.json#/$defs/tool"}}
  },
  "required": ["contract", "layers"],
  "$defs": {
    "tool": {
      "type": "object",
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}},
      "required": ["name", "version"]
    },
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "build": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "toolchain": {"type": "string"},
        "target": {"type": "string"},
        "profile": {"type": "string"},
        "features": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["id"]
    }
  }
}
