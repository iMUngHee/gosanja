{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "call-evidence.schema.json",
  "type": "object",
  "properties": {
    "caller": {"$ref": "syntax-fact.schema.json#/$defs/anchor"},
    "callee": {"$ref": "syntax-fact.schema.json#/$defs/anchor"},
    "mechanism": {"$ref": "relation.schema.json#/$defs/mechanism"},
    "resolution": {
      "allOf": [{"$ref": "relation.schema.json#/$defs/resolution"}, {"not": {"const": "declared"}}]
    },
    "site": {
      "type": "object",
      "properties": {
        "file": {"$ref": "file.schema.json#/$defs/path"},
        "line": {"type": "integer", "minimum": 0},
        "col": {"type": "integer", "minimum": 0}
      },
      "required": ["file", "line"]
    },
    "build": {"type": "string"}
  },
  "required": ["caller", "callee", "mechanism", "resolution", "build"]
}
